# Copy to infra/langfuse/.env (gitignored) and replace every placeholder with
# a freshly generated secret. Nothing here is a real secret.
#
# Generate each value, for example:
#   openssl rand -hex 32        # NEXTAUTH_SECRET, SALT, ENCRYPTION_KEY (ENCRYPTION_KEY must be 64 hex chars)
#   openssl rand -base64 24     # the passwords
# Without openssl: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NEXTAUTH_SECRET=replace-me
SALT=replace-me
ENCRYPTION_KEY=replace-me-with-64-hex-chars
POSTGRES_PASSWORD=replace-me
CLICKHOUSE_PASSWORD=replace-me
MINIO_ROOT_PASSWORD=replace-me
REDIS_AUTH=replace-me
