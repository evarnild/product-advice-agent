# Copy to .env (gitignored) and fill in. Placeholders only; never commit real values.

# Model provider and model. Defaults: anthropic / claude-haiku-5-5.
ADVISOR_MODEL_PROVIDER=anthropic
# ADVISOR_MODEL=claude-haiku-5-5

# Required for the anthropic provider.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Tracing to the local Langfuse (infra/langfuse). Tracing is off unless all
# three are set. Create the project and keys in the Langfuse UI.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
