# Copy to .env (gitignored) and fill in. Placeholders only; never commit real values.

# Model provider and model, commented out with their defaults. With nothing
# set the advisor uses the local Ollama model. Uncomment the provider only to
# switch to anthropic (and then set ANTHROPIC_API_KEY below).
# ADVISOR_MODEL_PROVIDER=ollama
# ADVISOR_MODEL=qwen3:8b

# Where Ollama listens (ollama provider only). Must be http:// or https://.
# ADVISOR_OLLAMA_URL=http://localhost:11434

# Needed only for the anthropic provider; the ollama provider never reads it.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Tracing to the local Langfuse (infra/langfuse). Tracing is off unless all
# three are set. Create the project and keys in the Langfuse UI.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
